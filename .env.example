# Copy to .env (git-ignored). docker compose reads it automatically.
# Encrypts API keys entered in Settings. Generate with: openssl rand -base64 32
# Back it up: losing it makes UI-entered keys unrecoverable.
RESEARCH_AGENT_SECRETS_KEY=
# Admin for headless setup with `docker compose run --rm seed` (password >= 12
# chars; only used on first create). Not needed if you use setup in the browser.
RESEARCH_AGENT_ADMIN_EMAIL=
RESEARCH_AGENT_ADMIN_PASSWORD=
RESEARCH_AGENT_ADMIN_NAME=
# SearXNG's secret; the compose default is insecure. Generate with: openssl rand -hex 32
SEARXNG_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
# Any OpenAI-compatible endpoint (llama.cpp, LM Studio, vLLM, Ollama). Read when
# the workspace is created. Default: the compose `ollama` service. For a server
# on this machine: http://host.docker.internal:<port>/v1 (LM Studio 1234, Ollama 11434)
# LOCAL_LLM_BASE_URL=
